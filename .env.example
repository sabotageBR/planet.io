# copie para .env (não versionado)
DATABASE_URL=postgres://planet:planet@127.0.0.1:5433/planet
DB_POOL_MAX=3
MIGRATE_ON_START=1
PORT=3001
SHARD=0
SHARDS=1
ROOM_MAX=30
ROOM_BOTS=32
# 0 = usa o mundo do build; o /admin (WORLD.LADO) manda, e vale no próximo boot
WORLD_SIDE=0
LOG_LEVEL=info

# fala dos bots por LLM (opcional). Sem OLLAMA_URL o chat usa o repertório fixo de BOT_CHAT, como sempre.
# O modelo fica residente por `keep_alive`: carregá-lo custa ~27 s, respondê-lo custa ~0,5 s.
OLLAMA_URL=http://192.168.8.251:11434
OLLAMA_MAX_INFLIGHT=4
# O modelo é SEMENTE: daqui em diante quem manda é o /admin (Parâmetros → Fala dos bots → Modelo da LLM),
# e um nome fora da lista do painel é acrescentado a ela no boot em vez de recusado.
OLLAMA_MODEL=gpt-oss:20b
BOT_CHAT_LLM=1
# Login com Google: o client_id do console (Origens JavaScript autorizadas = a origem do jogo).
# Público por definição — vai no HTML. O client_secret NÃO é usado: o servidor só valida o id_token.
# Vazio = a rota /api/auth/google devolve 503 e o botão nem aparece na tela.
GOOGLE_CLIENT_ID=
# Moderação de avatar (DELETE /api/avatar/:id); vazio = rota desligada
ADMIN_TOKEN=

# Origens que podem falar com /api de FORA (o cliente empacotado em portais de jogos, dentro de um
# iframe no domínio deles). VAZIO = fechado, que é o comportamento de sempre. Aceita origem exata ou
# sufixo (`https://*.itch.zone`). O WebSocket nunca dependeu disto — ele não é sujeito a CORS.
ALLOWED_ORIGINS=
# Origem do handshake do WS: off (aceita tudo, como sempre) | warn (aceita e loga) | on (403).
# Estreie em `warn` e leia o log: a origem real de cada portal não é adivinhável.
WS_ORIGIN_CHECK=off
